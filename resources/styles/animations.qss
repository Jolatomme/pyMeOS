/* =============================================================================
   PyMeOS Animations Stylesheet
   
   Qt-compatible animations - Only uses properties supported by Qt
   Note: Qt's QSS support is limited compared to CSS.
   We only use standard Qt properties that work across all platforms.
   ============================================================================= */

/* -----------------------------------------------------------------------------
   Button Animations (using Qt properties only)
   ---------------------------------------------------------------------------- */

QPushButton {
    /* No CSS transitions in Qt - animations must be done via QPropertyAnimation */
}

QPushButton:hover {
    /* Hover state styling */
}

QPushButton:pressed {
    /* Pressed state styling */
}

/* -----------------------------------------------------------------------------
   Tab Animations
   ---------------------------------------------------------------------------- */

QTabBar::tab {
    /* Tab styling */
}

QTabBar::tab:selected {
    /* Selected tab styling */
}

QTabBar::tab:hover:!selected {
    /* Hover tab styling */
}

/* -----------------------------------------------------------------------------
   Input Field Animations
   ---------------------------------------------------------------------------- */

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    /* Focus styling - Qt handles the transition automatically */
}

/* -----------------------------------------------------------------------------
   Table Animations
   ---------------------------------------------------------------------------- */

QTableView::item:hover {
    /* Hover row styling */
}

QTableView::item:selected {
    /* Selected row styling */
}

/* -----------------------------------------------------------------------------
   Menu Animations
   ---------------------------------------------------------------------------- */

QMenu::item:selected {
    /* Selected menu item styling */
}

/* -----------------------------------------------------------------------------
   Note: True CSS animations (keyframes, transitions) are NOT supported by Qt.
   For advanced animations, use QPropertyAnimation in Python code.
   
   Example:
   
   from PySide6.QtCore import QPropertyAnimation, QEasingCurve
   
   anim = QPropertyAnimation(button, b"geometry")
   anim.setDuration(200)
   anim.setStartValue(button.geometry())
   anim.setEndValue(new_geometry)
   anim.setEasingCurve(QEasingCurve.OutQuad)
   anim.start()
   
   ============================================================================= */
